# ====================================================================
# C++ 專案標準 .gitignore
# ====================================================================

# --- 編譯過程產物 (Build Artifacts) ---
*.o
*.obj
*.slo
*.lo
*.gch
*.pch
*.d
*.dwo

# --- 靜態與動態函式庫 (Libraries) ---
*.lib
*.a
*.la
*.lai
*.so
*.dylib
*.dll

# --- 執行檔與除錯檔 (Executables & Debugging) ---
*.exe
*.out
*.app
*.ilk
*.pdb
*.exp

# --- 現代構建系統 (CMake / Make) ---
# 忽略整個 build 資料夾（這是最推薦的做法）
[Bb]uild/
CMakeFiles/
CMakeCache.txt
CMakeScripts/
cmake_install.cmake
Makefile

# --- 編輯器與 IDE 設定 (IDEs) ---
# Visual Studio
.vs/
*.user
*.sln.docstates

# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

# CLion / JetBrains
.idea/
cmake-build-*/

# --- Fortran 相關 (如有混合開發) ---
*.mod
*.smod

# --- 作業系統暫存檔 (OS specific) ---
.DS_Store
Thumbs.db
